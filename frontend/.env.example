# Base URL of the FastAPI server (no trailing slash). Routes live under /api/sessions.
VITE_API_URL=http://localhost:8000

# Use the backend for actual role privacy. The browser mock is demo data only.
VITE_USE_MOCK_API=false

# Mock only: fake players join a newly created room every ~1.5s.
VITE_MOCK_BOTS=false
